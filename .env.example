# Supabase (optional). Leave both empty to run the store in demo mode.
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the deployed site, used for SEO metadata and auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never put the Supabase service-role key in this app. It is not needed.
